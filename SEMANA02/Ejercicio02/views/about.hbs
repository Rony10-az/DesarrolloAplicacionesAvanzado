<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>

<body>
    <h1>{{WelcomeMessage}}</h1>
    <h2>Lista de Cursos</h2>
    <ul>
        {{#each cursos}}
        <li>Nombre del curso : {{this.nombre}}
        <li>Profesor : {{this.profesor}}
        <li>fecha: {{this.fecha}}
        </li>
        {{/each}}
    </ul>
</body>

</html>