    <script src="/vendor/materialize/js/materialize.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            M.Sidenav.init(document.querySelectorAll('.sidenav'));
            M.FormSelect.init(document.querySelectorAll('select'));

            // Revela las secciones con animación al entrar en pantalla
            var revealables = document.querySelectorAll('.reveal');
            if ('IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('revealed');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.15 });
                revealables.forEach(function (el) { observer.observe(el); });
            } else {
                revealables.forEach(function (el) { el.classList.add('revealed'); });
            }

            // Anima las barras de estadísticas hasta su valor real
            var bars = document.querySelectorAll('.stat-bar-fill');
            setTimeout(function () {
                bars.forEach(function (bar) {
                    bar.style.width = (bar.dataset.percentage || 0) + '%';
                });
            }, 250);

            // Cuenta ascendente de los números
            document.querySelectorAll('.count-up').forEach(function (el) {
                var target = Number(el.dataset.target || 0);
                var duration = 1200;
                var start = null;

                function step(timestamp) {
                    if (!start) start = timestamp;
                    var progress = Math.min((timestamp - start) / duration, 1);
                    el.textContent = Math.round(progress * target);
                    if (progress < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            });
        });
    </script>
