<%- include('partials/header') %>

<%- include('partials/pageHero', {
    heroTitle: 'ADMIN',
    heroSubtitle: 'Mensajes recibidos desde el formulario de contacto.',
    heroImage: '/images/hero/campnou.jpg',
    heroIcon: 'admin_panel_settings'
}) %>

<div class="container">
    <div class="section">
        <div class="row summary-row">
            <div class="col s12 m4">
                <div class="summary-card reveal">
                    <i class="material-icons">mark_email_unread</i>
                    <span class="summary-number count-up" data-target="<%= messages.length %>">0</span>
                    <span class="summary-label">Mensajes recibidos</span>
                </div>
            </div>
        </div>

        <h2 class="section-title reveal">Bandeja de entrada</h2>

        <% if (messages.length === 0) { %>
            <div class="empty-state reveal">
                <i class="material-icons">inbox</i>
                <p>Aún no hay mensajes.</p>
                <a href="/contact" class="btn waves-effect app-btn-gold">
                    Ir al formulario <i class="material-icons right">arrow_forward</i>
                </a>
            </div>
        <% } else { %>
            <div class="row">
                <% messages.forEach(function (msg, index) { %>
                    <div class="col s12 m6">
                        <div class="message-card reveal" style="transition-delay:<%= (index % 2) * 0.1 %>s">
                            <div class="message-head">
                                <span class="message-avatar"><%= msg.name ? msg.name.charAt(0).toUpperCase() : '?' %></span>
                                <div>
                                    <span class="message-name"><%= msg.name %></span>
                                    <span class="message-email"><%= msg.email %></span>
                                </div>
                                <span class="message-index">#<%= index + 1 %></span>
                            </div>
                            <p class="message-text"><%= msg.mensaje %></p>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
