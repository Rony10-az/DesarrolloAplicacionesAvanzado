<%- include('partials/header') %>

<%- include('partials/pageHero', {
    heroTitle: 'LA VOTACIÓN',
    heroSubtitle: 'Elige a tu candidato y descubre en tiempo real hacia dónde se inclina la afición.',
    heroImage: '/images/hero/allianz.jpg',
    heroIcon: 'how_to_vote'
}) %>

<div class="container">

    <!-- Resumen -->
    <div class="section">
        <div class="row summary-row">
            <div class="col s6 m3">
                <div class="summary-card reveal">
                    <i class="material-icons">how_to_vote</i>
                    <span class="summary-number count-up" data-target="<%= totalVotes %>">0</span>
                    <span class="summary-label">Votos emitidos</span>
                </div>
            </div>
            <div class="col s6 m3">
                <div class="summary-card reveal" style="transition-delay:.1s">
                    <i class="material-icons">groups</i>
                    <span class="summary-number count-up" data-target="<%= candidates.length %>">0</span>
                    <span class="summary-label">Candidatos</span>
                </div>
            </div>
            <div class="col s6 m3">
                <div class="summary-card reveal" style="transition-delay:.2s">
                    <i class="material-icons">trending_up</i>
                    <span class="summary-number"><span class="count-up" data-target="<%= leader ? leader.percentage : 0 %>">0</span>%</span>
                    <span class="summary-label">Ventaja del líder</span>
                </div>
            </div>
            <div class="col s6 m3">
                <div class="summary-card reveal" style="transition-delay:.3s">
                    <i class="material-icons">insights</i>
                    <span class="summary-number"><span class="count-up" data-target="<%= averageConfidence %>">0</span>%</span>
                    <span class="summary-label">Confianza media</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Líder actual -->
    <% if (leader) { %>
        <div class="section">
            <div class="leader-banner reveal">
                <img src="<%= leader.photo %>" alt="<%= leader.name %>" class="leader-photo">
                <div class="leader-info">
                    <span class="leader-tag"><i class="material-icons">emoji_events</i> Favorito de la afición</span>
                    <h3><%= leader.name %></h3>
                    <p class="leader-meta">
                        <img src="<%= leader.flag %>" alt="Bandera de <%= leader.country %>" class="flag-img">
                        <%= leader.country %> · <%= leader.team %> · <%= leader.position %>
                    </p>
                    <div class="leader-score">
                        <span class="leader-percentage"><%= leader.percentage %>%</span>
                        <span class="leader-votes"><%= leader.votes %> votos de <%= totalVotes %></span>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <div class="row">
        <!-- Formulario de votación -->
        <div class="col s12 l6">
            <form class="vote-card reveal" action="/balon-de-oro" method="POST">
                <h2 class="section-title small">Emite tu voto</h2>

                <!-- Selección de candidato con foto y bandera -->
                <p class="field-legend"><span class="step-number">1</span> Elige a tu candidato</p>
                <div class="candidate-options">
                    <% candidates.forEach(function (c) { %>
                        <label class="candidate-option">
                            <input name="candidateId" type="radio" value="<%= c.id %>"
                                   data-name="<%= c.name %>" data-photo="<%= c.photo %>"
                                   data-team="<%= c.team %>" data-flag="<%= c.flag %>"
                                   data-country="<%= c.country %>" required>
                            <span class="candidate-card">
                                <span class="candidate-photo-wrap">
                                    <img src="<%= c.photo %>" alt="<%= c.name %>" class="candidate-photo">
                                    <img src="<%= c.flag %>" alt="Bandera de <%= c.country %>" class="candidate-flag">
                                </span>
                                <span class="candidate-name"><%= c.name %></span>
                                <span class="candidate-team"><%= c.team %></span>
                                <span class="candidate-check"><i class="material-icons">check_circle</i></span>
                            </span>
                        </label>
                    <% }); %>
                </div>

                <!-- Vista previa del candidato elegido -->
                <div class="selection-preview" id="selectionPreview">
                    <img src="" alt="" class="selection-photo" id="selectionPhoto">
                    <div class="selection-text">
                        <span class="selection-label">Tu voto será para</span>
                        <span class="selection-name" id="selectionName">—</span>
                        <span class="selection-meta" id="selectionMeta"></span>
                    </div>
                    <img src="" alt="" class="selection-flag" id="selectionFlag">
                </div>

                <!-- Datos del votante -->
                <p class="field-legend"><span class="step-number">2</span> Tus datos</p>
                <div class="row">
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">person</i>
                        <input id="voterName" name="voterName" type="text">
                        <label for="voterName">Tu nombre (opcional)</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <i class="material-icons prefix">public</i>
                        <select name="voterCountry">
                            <% voterCountries.forEach(function (country) { %>
                                <option value="<%= country %>" <%= country === 'Perú' ? 'selected' : '' %>><%= country %></option>
                            <% }); %>
                        </select>
                        <label>¿Desde dónde votas?</label>
                    </div>
                </div>

                <!-- Motivo y confianza -->
                <p class="field-legend"><span class="step-number">3</span> ¿Por qué lo eliges?</p>
                <div class="input-field">
                    <i class="material-icons prefix">psychology</i>
                    <select name="reason">
                        <% reasons.forEach(function (r) { %>
                            <option value="<%= r.id %>"><%= r.label %></option>
                        <% }); %>
                    </select>
                    <label>Motivo principal</label>
                </div>

                <p class="range-legend">
                    ¿Qué tan seguro estás? <span class="range-value" id="confidenceValue">70</span>%
                </p>
                <p class="range-field">
                    <input type="range" id="confidence" name="confidence" min="0" max="100" value="70">
                </p>

                <div class="input-field">
                    <i class="material-icons prefix">chat</i>
                    <textarea id="comment" name="comment" class="materialize-textarea"></textarea>
                    <label for="comment">Comentario (opcional)</label>
                </div>

                <div class="right-align">
                    <button type="submit" class="btn-large waves-effect app-btn-gold">
                        Registrar mi voto
                        <i class="material-icons right">send</i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Estadísticas -->
        <div class="col s12 l6" id="estadisticas">
            <div class="stats-card reveal">
                <h2 class="section-title small">Ranking en vivo</h2>
                <p class="stats-caption">Basado en <%= totalVotes %> votos registrados.</p>

                <% stats.forEach(function (c, index) { %>
                    <div class="stat-row <%= index === 0 && totalVotes > 0 ? 'is-leader' : '' %>">
                        <span class="stat-position"><%= index + 1 %></span>
                        <span class="stat-photo-wrap">
                            <img src="<%= c.photo %>" alt="<%= c.name %>" class="stat-photo">
                            <img src="<%= c.flag %>" alt="Bandera de <%= c.country %>" class="stat-flag">
                        </span>
                        <div class="stat-body">
                            <div class="stat-head">
                                <span class="stat-name"><%= c.name %></span>
                                <span class="stat-value"><%= c.percentage %>% · <%= c.votes %></span>
                            </div>
                            <div class="stat-bar">
                                <div class="stat-bar-fill" data-percentage="<%= c.percentage %>" style="width:0%"></div>
                            </div>
                            <span class="stat-team"><%= c.team %></span>
                        </div>
                    </div>
                <% }); %>
            </div>

            <div class="stats-card reveal" style="transition-delay:.15s">
                <h2 class="section-title small">¿Por qué votan?</h2>
                <p class="stats-caption">Motivo principal declarado por los votantes.</p>

                <% reasonStats.forEach(function (r) { %>
                    <div class="reason-row">
                        <div class="stat-head">
                            <span class="stat-name"><%= r.label %></span>
                            <span class="stat-value"><%= r.percentage %>%</span>
                        </div>
                        <div class="stat-bar">
                            <div class="stat-bar-fill alt" data-percentage="<%= r.percentage %>" style="width:0%"></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- Historial de votos -->
    <div class="section">
        <h2 class="section-title reveal">Últimos votos registrados</h2>

        <% if (recentVotes.length === 0) { %>
            <div class="empty-state reveal">
                <i class="material-icons">how_to_vote</i>
                <p>Aún no hay votos. ¡Sé el primero en participar!</p>
            </div>
        <% } else { %>
            <div class="table-wrap reveal">
                <table class="vote-table">
                    <thead>
                        <tr>
                            <th>Votante</th>
                            <th>Candidato</th>
                            <th>Motivo</th>
                            <th>Confianza</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentVotes.forEach(function (v) { %>
                            <tr>
                                <td>
                                    <span class="voter-name"><%= v.voterName %></span>
                                    <span class="voter-country"><%= v.voterCountry %></span>
                                </td>
                                <td>
                                    <div class="table-candidate">
                                        <img src="<%= v.candidate.photo %>" alt="<%= v.candidate.name %>" class="table-photo">
                                        <img src="<%= v.candidate.flag %>" alt="Bandera de <%= v.candidate.country %>" class="flag-img">
                                        <span><%= v.candidate.name %></span>
                                    </div>
                                </td>
                                <td><%= v.reasonLabel %></td>
                                <td><span class="confidence-chip"><%= v.confidence %>%</span></td>
                                <td class="vote-date"><%= new Date(v.votedAt).toLocaleDateString('es-PE') %></td>
                            </tr>
                            <% if (v.comment) { %>
                                <tr class="comment-row">
                                    <td colspan="5">
                                        <i class="material-icons tiny">format_quote</i> <%= v.comment %>
                                    </td>
                                </tr>
                            <% } %>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Muestra el nombre y la foto del candidato elegido dentro del formulario
        var preview = document.getElementById('selectionPreview');
        var photo = document.getElementById('selectionPhoto');
        var flag = document.getElementById('selectionFlag');
        var name = document.getElementById('selectionName');
        var meta = document.getElementById('selectionMeta');

        document.querySelectorAll('input[name="candidateId"]').forEach(function (input) {
            input.addEventListener('change', function () {
                photo.src = input.dataset.photo;
                photo.alt = input.dataset.name;
                flag.src = input.dataset.flag;
                flag.alt = 'Bandera de ' + input.dataset.country;
                name.textContent = input.dataset.name;
                meta.textContent = input.dataset.team + ' · ' + input.dataset.country;
                preview.classList.add('is-active');
            });
        });

        // Valor del slider de confianza
        var confidence = document.getElementById('confidence');
        var confidenceValue = document.getElementById('confidenceValue');
        confidence.addEventListener('input', function () {
            confidenceValue.textContent = confidence.value;
        });
    });
</script>

<%- include('partials/footer') %>
